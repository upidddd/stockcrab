{
  "manifest_version": 3,
  "name": "StockCrab",
  "version": "0.1.1",
  "description": "Stockfish move hints for chess.com and lichess.org: best and other good moves with scores, and a premove hint.",
  "icons": {
    "16": "assets/icon-16.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "chess-sparring@local"
    }
  },
  "background": {
    "scripts": [
      "background/engine/models.js",
      "background/engine/aggression.js",
      "background/engine/uci-lines.js",
      "background/engine/search.js",
      "background/engine/boot.js",
      "background/engine/queue.js",
      "background/premove/analysis.js",
      "background/premove/pawn-trades.js",
      "background/premove/run.js",
      "background/main.js"
    ]
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "permissions": [
    "storage",
    "clipboardWrite"
  ],
  "content_scripts": [
    {
      "js": [
        "data/opening-book.js",
        "content/core/constants.js",
        "content/core/hold.js",
        "content/board/find.js",
        "content/core/settings.js",
        "content/board/orientation.js",
        "content/board/reader.js",
        "content/board/lichess.js",
        "content/hints/draw.js",
        "content/rating/kinds.js",
        "content/hints/icons.js",
        "content/rating/sacrifice.js",
        "content/rating/book.js",
        "content/rating/classify.js",
        "content/hints/marks.js",
        "content/ui/status.js",
        "content/rating/played-move.js",
        "content/core/tick.js",
        "content/ui/panel.js",
        "content/core/main.js"
      ],
      "matches": [
        "https://www.chess.com/*",
        "https://lichess.org/*",
        "https://www.lichess.org/*"
      ]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/*"
      ],
      "matches": [
        "https://www.chess.com/*",
        "https://chess.com/*",
        "https://lichess.org/*",
        "https://www.lichess.org/*"
      ]
    }
  ],
  "homepage_url": "https://github.com/upidddd/stockcrab"
}
