{
  "manifest_version": 3,
  "name": "StockCrab",
  "version": "0.1.0",
  "description": "Stockfish move hints for chess.com and lichess.org: best and other good moves with scores, and a premove hint.",
  "icons": {
    "16": "icon-16.png",
    "48": "icon-48.png",
    "128": "icon.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "chess-sparring@local"
    }
  },
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "permissions": [
    "storage",
    "clipboardWrite"
  ],
  "content_scripts": [
    {
      "js": [
        "book.js",
        "content.js"
      ],
      "matches": [
        "https://www.chess.com/*",
        "https://lichess.org/*",
        "https://www.lichess.org/*"
      ]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/*"
      ],
      "matches": [
        "https://www.chess.com/*",
        "https://chess.com/*",
        "https://lichess.org/*",
        "https://www.lichess.org/*"
      ]
    }
  ]
}